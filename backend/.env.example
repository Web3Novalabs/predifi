# Server
PREDIFI_APP_HOST=0.0.0.0
PREDIFI_APP_PORT=3000
# Deployment environment: development, staging, or production. Default: development.
PREDIFI_APP_ENV=development
# Rust log level. Default: info.
RUST_LOG=info
# Maximum time to allow in-flight shutdown draining before terminating. Default: 30 seconds.
PREDIFI_SHUTDOWN_TIMEOUT_SECS=30

# CORS — comma-separated list of allowed origins.
# Each entry must be a valid http:// or https:// origin (scheme + host + optional port).
# Paths, query strings, fragments, wildcards, and the 'null' origin are not permitted.
# Default: http://localhost:3000,http://localhost:5173,https://predifi.app
PREDIFI_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://predifi.app
# WebSocket origins — comma-separated list of allowed origins. Default: empty (permissive mode).
# PREDIFI_WS_ALLOWED_ORIGINS=https://predifi.app,https://admin.predifi.app

# PostgreSQL
PREDIFI_DATABASE_URL=postgres://postgres:postgres@localhost:5432/predifi
PREDIFI_DB_MAX_CONNECTIONS=10
PREDIFI_DB_MIN_CONNECTIONS=1
# Seconds to wait for a database connection from the pool. Default: 30 seconds.
PREDIFI_DB_ACQUIRE_TIMEOUT_SECS=30
# DB startup retry (issue #968)
# Default: 5 attempts.
PREDIFI_DB_CONNECT_MAX_ATTEMPTS=5
# Default: 200 milliseconds.
PREDIFI_DB_CONNECT_BASE_DELAY_MS=200
# Default: 5000 milliseconds.
PREDIFI_DB_CONNECT_MAX_DELAY_MS=5000
# Per-connection TCP/TLS handshake timeout in seconds (issue #1174).
# Controls how long sqlx waits for each individual connection to be established.
# Distinct from PREDIFI_DB_ACQUIRE_TIMEOUT_SECS which limits waiting for a pool slot.
# Default: 10 seconds.
PREDIFI_DB_CONNECT_TIMEOUT_SECS=10

# Redis (for caching hot data - issue #714)
# Default: redis://localhost:6379
PREDIFI_REDIS_URL=redis://localhost:6379

# Stellar RPC
# Default: https://soroban-testnet.stellar.org
PREDIFI_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Per-attempt timeout in seconds for the Stellar RPC health check. Default: 2 seconds.
PREDIFI_RPC_HEALTH_TIMEOUT_SECS=2
# Number of retry attempts for Stellar RPC health checks. Default: 3 retries.
PREDIFI_RPC_HEALTH_RETRY_COUNT=3
# Timeout in seconds for general Stellar RPC calls (event listener, sync worker). Default: 30 seconds.
RPC_TIMEOUT_SECS=30

# Fee Configuration
# Default: 300 bps (3%).
PREDIFI_TREASURY_FEE_BPS=300
# Default: 5000 bps (50%).
PREDIFI_REFERRAL_FEE_BPS=5000

# JWT
# JWT signing secret (must be at least 32 bytes in production). Default: dev-only placeholder.
PREDIFI_SECRET_KEY=predifi-dev-secret-do-not-use-in-production-32
# JWT signing key version. Default: 0. Increment to invalidate existing tokens.
PREDIFI_JWT_KEY_VERSION=0

# Stellar event indexer batch size (issue #1168)
# Default: 500 events per batch.
PREDIFI_INDEXER_MAX_BATCH_SIZE=500

# Sentry (optional — leave unset to disable error reporting)
# PREDIFI_SENTRY_DSN=https://your-key@sentry.io/your-project
