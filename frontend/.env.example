# PrediFi Frontend — Environment Variables
#
# Copy this file to `.env.local` and fill in the values:
#   cp frontend/.env.example frontend/.env.local
#
# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser.
# Never put secrets (API keys, private keys) in NEXT_PUBLIC_* variables.

# Base URL of the PrediFi backend API used by the data layer in `lib/api`.
# Default: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Stellar network the frontend connects to.
# One of: TESTNET, MAINNET, FUTURENET.
# Default: TESTNET
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
